{
  "name": "@airmax/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "../node_modules/.bin/eslint src",
    "format:check": "../node_modules/.bin/prettier --check src/app.module.ts src/main.ts src/common/http src/common/pagination src/config/infrastructure.config.ts src/health scripts/database test/backend-foundation.test.js test/database-backup-evidence.test.js test/database-deployment-safety.test.js README.md prisma/README.md package.json eslint.config.js",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "db:deploy:preflight": "node scripts/database/preflight.js",
    "db:deploy:safe": "node scripts/database/safe-deploy.js",
    "db:deploy:verify": "node scripts/database/verify.js",
    "db:backup:evidence:validate": "node scripts/database/validate-backup-evidence.js",
    "test:database": "node --test test/database-schema.test.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.11",
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/node": "^24.10.0",
    "@types/passport-jwt": "^4.0.1",
    "jsonc-parser": "^3.3.1",
    "prisma": "^6.19.1",
    "typescript": "~6.0.3"
  }
}
