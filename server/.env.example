# Local development example only. Production must inject these values through
# its deployment environment or managed secret store; server/.env is ignored.
NODE_ENV=development
DATABASE_URL=postgresql://airmax:airmax_local@localhost:5432/airmax
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-refresh-secret
JWT_ISSUER=airmax-api
JWT_AUDIENCE=airmax-clients
OTP_PEPPER=replace-with-at-least-32-character-otp-pepper
# MikroTik is optional, but all three values are required together when used.
MIKROTIK_BASE_URL=
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
PORT=4000
API_PREFIX=api/v1
REQUEST_BODY_LIMIT_BYTES=1048576
PAGINATION_DEFAULT_LIMIT=25
PAGINATION_MAX_LIMIT=100
LOG_LEVEL=log
ADMIN_ORIGIN=http://localhost:3000

# Production requirements:
# - NODE_ENV=production must be supplied explicitly.
# - DATABASE_URL must use PostgreSQL TLS with sslmode=require, verify-ca, or
#   verify-full and must not use local/private hosts or the airmax_local password.
# - REDIS_URL must use rediss:// and must not use a local/private host.
# - ADMIN_ORIGIN must contain HTTPS origins only.
# - JWT/OTP values must be unique production secrets, never these placeholders.
# - LOG_LEVEL cannot be debug.

# Database deployment wrapper variables (production deployment environment only):
# AIRMAX_DB_EXPECTED_HOST=db.example.invalid
# AIRMAX_DB_EXPECTED_PORT=5432
# AIRMAX_DB_EXPECTED_NAME=airmax
# AIRMAX_DB_DEPLOY_MODE=greenfield
# AIRMAX_RELEASE_SHA=0123456789abcdef0123456789abcdef01234567
# AIRMAX_DB_DEPLOY_APPROVAL=APPROVED
# AIRMAX_DB_MAINTENANCE_APPROVAL=APPROVED
# AIRMAX_DB_BACKUP_REFERENCE=provider-snapshot-or-backup-reference
# AIRMAX_HEALTH_BASE_URL=https://api.example.invalid
# AIRMAX_DB_REPORT_DIR=/var/lib/airmax/deployment-reports
# AIRMAX_MIGRATIONS_DIR is intentionally omitted: production uses the release's
# server/prisma/migrations directory unless an operator explicitly overrides it.
