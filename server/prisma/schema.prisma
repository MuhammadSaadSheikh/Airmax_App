generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DISABLED
}
enum PackageStatus {
  ACTIVE
  INACTIVE
}
enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}
enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
  VOID
  REFUNDED
}
enum ComplaintStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum TechnicianStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  phone String @unique
  email String? @unique
  passwordHash String
  role Role @default(CUSTOMER)
  status UserStatus @default(PENDING)
  address String?
  cnic String? @unique
  connectionId String? @unique
  installationDate DateTime?
  routerDetails Json?
  subscriptions Subscription[]
  invoices Invoice[]
  payments Payment[]
  complaints Complaint[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([role, status])
}

model Package {
  id String @id @default(uuid()) @db.Uuid
  name String
  speedMbps Int
  price Decimal @db.Decimal(12,2)
  durationDays Int @default(30)
  description String?
  features String[]
  status PackageStatus @default(ACTIVE)
  subscriptions Subscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  packageId String @db.Uuid
  status SubscriptionStatus @default(PENDING)
  startsAt DateTime
  expiresAt DateTime
  pppoeUsername String? @unique
  user User @relation(fields:[userId], references:[id])
  package Package @relation(fields:[packageId], references:[id])
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status])
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid
  number String @unique
  userId String @db.Uuid
  subscriptionId String? @db.Uuid
  amount Decimal @db.Decimal(12,2)
  status InvoiceStatus @default(UNPAID)
  dueAt DateTime
  paidAt DateTime?
  user User @relation(fields:[userId], references:[id])
  subscription Subscription? @relation(fields:[subscriptionId], references:[id])
  payments Payment[]
  createdAt DateTime @default(now())
  @@index([userId, dueAt])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  invoiceId String @db.Uuid
  amount Decimal @db.Decimal(12,2)
  method String
  providerReference String @unique
  idempotencyKey String @unique
  verifiedAt DateTime?
  user User @relation(fields:[userId], references:[id])
  invoice Invoice @relation(fields:[invoiceId], references:[id])
  createdAt DateTime @default(now())
}

model ServiceArea {
  id String @id @default(uuid()) @db.Uuid
  city String
  name String
  active Boolean @default(true)
  technicians Technician[]
  @@unique([city, name])
}

model Technician {
  id String @id @default(uuid()) @db.Uuid
  name String
  phone String @unique
  areaId String? @db.Uuid
  status TechnicianStatus @default(AVAILABLE)
  area ServiceArea? @relation(fields:[areaId], references:[id])
  complaints Complaint[]
}

model Complaint {
  id String @id @default(uuid()) @db.Uuid
  ticketNumber Int @unique @default(autoincrement())
  userId String @db.Uuid
  category String
  description String
  attachmentUrl String?
  status ComplaintStatus @default(PENDING)
  technicianId String? @db.Uuid
  adminReply String?
  user User @relation(fields:[userId], references:[id])
  technician Technician? @relation(fields:[technicianId], references:[id])
  events ComplaintEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  @@index([userId, status])
  @@index([technicianId, status])
}

model ComplaintEvent {
  id String @id @default(uuid()) @db.Uuid
  complaintId String @db.Uuid
  status ComplaintStatus
  note String?
  actorId String @db.Uuid
  complaint Complaint @relation(fields:[complaintId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  title String
  message String
  data Json?
  readAt DateTime?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
}
